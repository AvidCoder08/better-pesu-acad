# Local environment variables (copy to .env)
# Firebase
# Path to your Firebase service account JSON file (recommended)
FIREBASE_SERVICE_ACCOUNT="C:\\path\\to\\firebase-service-account.json"
# Alternatively, provide JSON content directly
# FIREBASE_SERVICE_ACCOUNT_JSON='{ "type": "service_account", ... }'
FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"

# Google Drive
# Path to your Google Drive service account JSON file
GOOGLE_DRIVE_SERVICE_ACCOUNT="C:\\path\\to\\google-drive-service-account.json"
# Optional: Shared Drive ID
GOOGLE_DRIVE_SHARED_DRIVE_ID=""

# Optional (used by Firebase if set)
GOOGLE_APPLICATION_CREDENTIALS=""
